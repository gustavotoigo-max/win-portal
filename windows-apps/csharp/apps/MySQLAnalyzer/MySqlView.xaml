<controls:ToolView x:Class="WinPortal.Apps.MySqlAnalyzer.MySqlView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:WinPortal.Ui.Controls;assembly=WinPortal.Ui">
    <controls:ToolPage Title="Analisador de banco MySQL"
                       Subtitle="Análise heurística dos arquivos da pasta de dados (datadir): páginas InnoDB, redo logs, metadados .sdi/.frm e entropia de cada arquivo.">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <controls:PathField x:Name="Folder" Label="Pasta" Kind="Folder" ToolId="mysql_analyzer"
                                        DialogTitle="Selecione a pasta do banco (datadir)" TextChanged="OnPathChanged" />
                    <controls:ActionBar x:Name="Actions" PrimaryText="Analisar" CanStart="False"
                                        PrimaryClick="OnAnalyze" CancelClick="OnCancel" />
                </StackPanel>
            </Border>

            <controls:ProgressCard x:Name="Progress" Grid.Row="1" ReadyText="Selecione a pasta de dados do MySQL e clique em Analisar." />

            <controls:ResultsCard x:Name="ResultsCard" Grid.Row="2"
                                  Placeholder="O resultado de cada arquivo aparece aqui."
                                  ExportClick="OnExport" ClearClick="OnClear">
                <DataGrid x:Name="ResultsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Arquivo" Binding="{Binding Path}" Width="3*" />
                        <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="Badge" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                            Background="{StaticResource SuccessSoftBrush}">
                                        <TextBlock x:Name="BadgeText" Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessTextBrush}" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Ok}" Value="False">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource DangerTextBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Detalhes" Binding="{Binding Detail}" Width="2*" />
                        <DataGridTextColumn Header="Entropia" Binding="{Binding EntropyText}" Width="90" SortMemberPath="Entropy" />
                    </DataGrid.Columns>
                </DataGrid>
            </controls:ResultsCard>
        </Grid>
    </controls:ToolPage>
</controls:ToolView>

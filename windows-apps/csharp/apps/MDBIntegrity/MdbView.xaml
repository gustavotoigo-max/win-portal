<controls:ToolView x:Class="WinPortal.Apps.MdbIntegrity.MdbView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:WinPortal.Ui.Controls;assembly=WinPortal.Ui">
    <controls:ToolPage Title="Verificação de bancos Access"
                       Subtitle="Abre cada arquivo .mdb/.accdb em modo somente leitura, confere o COUNT(*) de cada tabela e lê todos os registros.">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <controls:FormRow Label="Bancos">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AddFolderButton" Content="Selecionar pasta…" Click="OnAddFolder"
                                    ToolTip="Adiciona todos os .mdb/.accdb da pasta e das subpastas." />
                            <Button x:Name="AddFilesButton" Content="Selecionar arquivos…" Margin="8,0,0,0" Click="OnAddFiles" />
                            <Button x:Name="RemoveButton" Content="Remover selecionados" Margin="8,0,0,0" Click="OnRemove" />
                            <TextBlock Text="ou arraste arquivos e pastas para a lista" Style="{StaticResource StatusText}"
                                       Foreground="{StaticResource TextSubtleBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </controls:FormRow>
                    <controls:FormRow Label="Opções">
                        <WrapPanel VerticalAlignment="Center">
                            <CheckBox x:Name="DeepHashCheck" Content="Verificação profunda com SHA-256 da leitura" IsChecked="True" Margin="0,0,24,0" />
                            <CheckBox x:Name="SystemTablesCheck" Content="Incluir tabelas de sistema" Margin="0,0,24,0" />
                            <CheckBox x:Name="StopOnErrorCheck" Content="Parar no primeiro erro" />
                        </WrapPanel>
                    </controls:FormRow>
                    <controls:ActionBar x:Name="Actions" PrimaryText="Verificar bancos" CanStart="False"
                                        PrimaryClick="OnCheck" CancelClick="OnCancel" />
                </StackPanel>
            </Border>

            <controls:ProgressCard x:Name="Progress" Grid.Row="1" ReadyText="Adicione os bancos .mdb/.accdb e clique em Verificar bancos." />

            <controls:ResultsCard x:Name="ResultsCard" Grid.Row="2" Title="ARQUIVOS E RESULTADOS" ExportClick="OnExport" ClearClick="OnClear">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="ResultsGrid" SelectionMode="Extended" AllowDrop="True"
                          MouseDoubleClick="OnGridDoubleClick" Drop="OnDrop" DragOver="OnDragOver">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="2*" MinWidth="180" />
                        <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="Badge" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                            Background="{StaticResource SurfaceAltBrush}">
                                        <TextBlock x:Name="BadgeText" Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Ok">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Error">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource DangerTextBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Tabelas" Binding="{Binding TablesText}" SortMemberPath="TablesSort" Width="80" />
                        <DataGridTextColumn Header="Registros" Binding="{Binding RecordsText}" SortMemberPath="RecordsSort" Width="95" />
                        <DataGridTextColumn Header="Tempo" Binding="{Binding TimeText}" SortMemberPath="TimeSort" Width="80" />
                        <DataGridTextColumn Header="Detalhes" Binding="{Binding ShortDetail}" Width="3*" MinWidth="200" />
                    </DataGrid.Columns>
                </DataGrid>
                    <controls:LogConsole x:Name="Log" Grid.Column="2" />
                </Grid>
            </controls:ResultsCard>
        </Grid>
    </controls:ToolPage>
</controls:ToolView>

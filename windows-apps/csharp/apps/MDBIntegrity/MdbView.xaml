<UserControl x:Class="WinPortal.Apps.MdbIntegrity.MdbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinPortal.Ui.Controls;assembly=WinPortal.Ui">
    <controls:ToolPage Title="Verificação de bancos Access"
                       Subtitle="Abre cada arquivo .mdb/.accdb em modo somente leitura, confere o COUNT(*) de cada tabela e lê todos os registros.">
        <controls:ToolPage.HeaderContent>
            <Border Style="{StaticResource Pill}">
                <TextBlock x:Name="CounterText" Text="Aguardando arquivos" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" />
            </Border>
        </controls:ToolPage.HeaderContent>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <Button x:Name="AddFilesButton" Content="Adicionar arquivos" Click="OnAddFiles" />
                        <Button x:Name="AddFolderButton" Content="Adicionar pasta" Margin="10,0,0,0" Click="OnAddFolder" />
                        <Button x:Name="RemoveButton" Content="Remover" Margin="10,0,0,0" Click="OnRemove" />
                        <Button x:Name="ClearButton" Content="Limpar" Margin="10,0,0,0" Click="OnClear" />
                        <Button x:Name="ExportButton" DockPanel.Dock="Right" Content="Exportar CSV" Margin="10,0,0,0" Click="OnExport" />
                        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancelar" Style="{StaticResource DangerButton}"
                                Margin="10,0,0,0" IsEnabled="False" Click="OnCancel" />
                        <Button x:Name="CheckButton" DockPanel.Dock="Right" Content="Verificar bancos" Style="{StaticResource PrimaryButton}"
                                Click="OnCheck" />
                    </DockPanel>
                    <WrapPanel Margin="0,14,0,0">
                        <CheckBox x:Name="DeepHashCheck" Content="Verificação profunda com SHA-256 da leitura" IsChecked="True" Margin="0,0,24,0" />
                        <CheckBox x:Name="SystemTablesCheck" Content="Incluir tabelas de sistema" Margin="0,0,24,0" />
                        <CheckBox x:Name="StopOnErrorCheck" Content="Parar no primeiro erro" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="Clique duas vezes para ver detalhes" FontSize="11.5"
                                       Foreground="{StaticResource TextSubtleBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="ARQUIVOS E RESULTADOS" Style="{StaticResource SectionLabelText}" Margin="0" />
                        </DockPanel>
                        <DataGrid x:Name="ResultsGrid" Grid.Row="1" SelectionMode="Extended" AllowDrop="True"
                                  MouseDoubleClick="OnGridDoubleClick" Drop="OnDrop" DragOver="OnDragOver">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="2*" MinWidth="180" />
                                <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Badge" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                                    Background="{StaticResource SurfaceAltBrush}">
                                                <TextBlock x:Name="BadgeText" Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Running">
                                                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                    <Setter TargetName="BadgeText" Property="Foreground" Value="#92400E" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Ok">
                                                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                    <Setter TargetName="BadgeText" Property="Foreground" Value="#166534" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Error">
                                                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                    <Setter TargetName="BadgeText" Property="Foreground" Value="#991B1B" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tabelas" Binding="{Binding TablesText}" SortMemberPath="TablesSort" Width="80" />
                                <DataGridTextColumn Header="Registros" Binding="{Binding RecordsText}" SortMemberPath="RecordsSort" Width="95" />
                                <DataGridTextColumn Header="Tempo" Binding="{Binding TimeText}" SortMemberPath="TimeSort" Width="80" />
                                <DataGridTextColumn Header="Detalhes" Binding="{Binding ShortDetail}" Width="3*" MinWidth="200" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Limpar log" Click="OnClearLog" />
                            <TextBlock Text="LOG" Style="{StaticResource SectionLabelText}" Margin="0" />
                        </DockPanel>
                        <controls:LogConsole x:Name="Log" Grid.Row="1" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,16">
                <StackPanel>
                    <ProgressBar x:Name="Progress" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource StatusText}" Margin="0,10,0,0" Text="Pronto" />
                </StackPanel>
            </Border>
        </Grid>
    </controls:ToolPage>
</UserControl>

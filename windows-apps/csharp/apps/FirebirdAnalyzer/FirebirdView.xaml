<controls:ToolView x:Class="WinPortal.Apps.FirebirdAnalyzer.FirebirdView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:WinPortal.Ui.Controls;assembly=WinPortal.Ui">
    <controls:ToolPage Title="Validador Firebird"
                       Subtitle="Executa gfix -v -full em um banco .fdb/.gdb ou em todos os bancos de uma pasta e gera um relatório CSV.">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <controls:PathField x:Name="Target" Label="Pasta ou banco" Kind="FolderOrFile" ToolId="firebird_analyzer"
                                        Filter="Firebird DB (*.fdb;*.gdb)|*.fdb;*.gdb|Todos os arquivos (*.*)|*.*"
                                        DialogTitle="Selecione a pasta com os bancos ou um arquivo .fdb/.gdb"
                                        TextChanged="OnInputChanged" />
                    <controls:PathField x:Name="Gfix" Label="Executável gfix" Kind="File" ToolId="firebird_analyzer.gfix"
                                        Filter="gfix.exe|gfix.exe|Executáveis (*.exe)|*.exe" DialogTitle="Localize o gfix.exe"
                                        Hint="Nome no PATH ou caminho completo do gfix.exe." TextChanged="OnInputChanged" />
                    <controls:FormRow Label="Credenciais">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Usuário" Style="{StaticResource StatusText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="UserBox" Grid.Column="1" Text="SYSDBA" />
                            <TextBlock Grid.Column="2" Text="Senha" Style="{StaticResource StatusText}" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <PasswordBox x:Name="PasswordBox" Grid.Column="3" Password="masterkey" />
                            <TextBlock Grid.Column="4" Text="Tempo limite (s)" Style="{StaticResource StatusText}" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <TextBox x:Name="TimeoutBox" Grid.Column="5" Text="300" HorizontalContentAlignment="Right" />
                        </Grid>
                    </controls:FormRow>
                    <controls:ActionBar x:Name="Actions" PrimaryText="Validar bancos" CanStart="False"
                                        PrimaryClick="OnRun" CancelClick="OnCancel" />
                </StackPanel>
            </Border>

            <controls:ProgressCard x:Name="Progress" Grid.Row="1" ReadyText="Selecione uma pasta ou um banco e clique em Validar bancos." />

            <controls:ResultsCard x:Name="ResultsCard" Grid.Row="2"
                                  Placeholder="O resultado de cada banco aparece aqui."
                                  ExportClick="OnExport" ClearClick="OnClear">
                <controls:LogConsole x:Name="Log" />
            </controls:ResultsCard>
        </Grid>
    </controls:ToolPage>
</controls:ToolView>

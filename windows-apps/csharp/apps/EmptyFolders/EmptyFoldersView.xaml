<UserControl x:Class="WinPortal.Apps.EmptyFolders.EmptyFoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinPortal.Ui.Controls;assembly=WinPortal.Ui">
    <controls:ToolPage Title="Removedor de pastas vazias"
                       Subtitle="Lista as subpastas vazias (inclusive as que só contêm outras pastas vazias) para você conferir antes de apagar. A pasta raiz é sempre preservada.">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Pasta raiz" Style="{StaticResource FieldLabelText}" />
                    <TextBox x:Name="PathBox" Grid.Column="1" />
                    <Button x:Name="SelectButton" Grid.Column="2" Content="Selecionar" Margin="12,0,0,0" Click="OnSelect" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="ListButton" Content="Listar vazias" Click="OnList" />
                        <Button x:Name="CleanButton" Content="Apagar vazias" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" IsEnabled="False" Click="OnClean" />
                        <Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource DangerButton}" Margin="10,0,0,0" IsEnabled="False" Click="OnCancel" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,16">
                <StackPanel>
                    <ProgressBar x:Name="Progress" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource StatusText}" Margin="0,10,0,0"
                               Text="Selecione uma pasta para listar subpastas vazias." />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Limpar log" Click="OnClearLog" />
                        <TextBlock Text="LOG" Style="{StaticResource SectionLabelText}" Margin="0" />
                    </DockPanel>
                    <controls:LogConsole x:Name="Log" Grid.Row="1" />
                </Grid>
            </Border>
        </Grid>
    </controls:ToolPage>
</UserControl>

<controls:ToolView x:Class="WinPortal.Apps.RenameFolder.RenameFolderView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:WinPortal.Ui.Controls;assembly=WinPortal.Ui">
    <controls:ToolPage Title="Organizador de pastas"
                       Subtitle="Renomeia, em todas as subpastas, as pastas cujo nome contém o termo informado, usando o novo nome com numeração sequencial: Novo nome (1), Novo nome (2)... A lista é exibida para conferência antes de renomear.">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <controls:PathField x:Name="Folder" Label="Pasta" Kind="Folder" ToolId="rename_folder"
                                        DialogTitle="Selecione a pasta" TextChanged="OnInputChanged" />
                    <controls:FormRow Label="Termo de busca">
                        <TextBox x:Name="TermBox" TextChanged="OnInputChanged"
                                 ToolTip="Parte do nome das pastas a renomear (diferencia maiúsculas e minúsculas)." />
                    </controls:FormRow>
                    <controls:FormRow Label="Novo nome">
                        <TextBox x:Name="NewNameBox" TextChanged="OnInputChanged"
                                 ToolTip="As pastas recebem este nome seguido de (1), (2), (3)..." />
                    </controls:FormRow>
                    <controls:ActionBar x:Name="Actions" PrimaryText="Renomear pastas" CanStart="False"
                                        PrimaryClick="OnStart" CancelClick="OnCancel" />
                </StackPanel>
            </Border>

            <controls:ProgressCard x:Name="Progress" Grid.Row="1" ReadyText="Informe a pasta, o termo e o novo nome e clique em Renomear pastas." />

            <controls:ResultsCard x:Name="ResultsCard" Grid.Row="2" Title="PASTAS A RENOMEAR"
                                  Placeholder="As pastas encontradas aparecem aqui, com o nome atual e o novo nome."
                                  ExportClick="OnExport" ClearClick="OnClear">
                <controls:LogConsole x:Name="Log" />
            </controls:ResultsCard>
        </Grid>
    </controls:ToolPage>
</controls:ToolView>

<controls:ToolView x:Class="WinPortal.Apps.SectorDbRepair.SectorRepairView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:WinPortal.Ui.Controls;assembly=WinPortal.Ui">
    <controls:ToolPage Title="Reparo por setores"
                       Subtitle="Substitui setores preenchidos com marcadores de falha (ex.: BA AD DE AD) pelos setores do arquivo de referência, somente quando a vizinhança é idêntica nos dois arquivos.">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <controls:PathField x:Name="Damaged" Label="Arquivo danificado" Kind="File" ToolId="sector_db_repair"
                                        DialogTitle="Selecione o arquivo danificado"
                                        PathPicked="OnDamagedPicked" TextChanged="OnInputChanged" />
                    <controls:PathField x:Name="Reference" Label="Referência" Kind="File" ToolId="sector_db_repair"
                                        DialogTitle="Selecione o arquivo de referência"
                                        Hint="Cópia anterior ou semelhante do mesmo arquivo, usada como gabarito."
                                        TextChanged="OnInputChanged" />
                    <controls:PathField x:Name="Output" Label="Salvar em" Kind="SaveFile" ToolId="sector_db_repair"
                                        DialogTitle="Salvar arquivo reconstruído" TextChanged="OnInputChanged" />
                    <controls:FormRow Label="Parâmetros">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Setor (bytes)" Style="{StaticResource StatusText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="SectorBox" Grid.Column="1" Text="512" HorizontalContentAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="Marcadores" Style="{StaticResource StatusText}" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <TextBox x:Name="MarkersBox" Grid.Column="3" Text="BA AD DE AD" Style="{StaticResource MonoTextBox}"
                                     ToolTip="Bytes em hexadecimal. Separe vários marcadores com ponto e vírgula, ex.: BA AD DE AD; 00" />
                        </Grid>
                    </controls:FormRow>
                    <controls:ActionBar x:Name="Actions" PrimaryText="Reparar arquivo" CanStart="False"
                                        PrimaryClick="OnRepair" CancelClick="OnCancel" />
                </StackPanel>
            </Border>

            <controls:ProgressCard x:Name="Progress" Grid.Row="1" ReadyText="Selecione o arquivo danificado e a referência e clique em Reparar arquivo." />

            <controls:ResultsCard x:Name="ResultsCard" Grid.Row="2"
                                  Placeholder="O andamento do reparo aparece aqui."
                                  ExportClick="OnExport" ClearClick="OnClear">
                <controls:LogConsole x:Name="Log" />
            </controls:ResultsCard>
        </Grid>
    </controls:ToolPage>
</controls:ToolView>

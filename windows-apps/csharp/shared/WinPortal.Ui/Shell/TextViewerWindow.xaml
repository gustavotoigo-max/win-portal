<Window x:Class="WinPortal.Ui.Shell.TextViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinPortal.Ui.Controls"
        Width="860" Height="540" MinWidth="650" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Grid>
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" Style="{StaticResource PageTitleText}" FontSize="18" Margin="0,0,0,14" />
        <TextBox x:Name="Body" Grid.Row="1" Style="{StaticResource LogTextBox}" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Copiar" Margin="0,0,10,0" Click="OnCopy" />
            <Button Content="Fechar" Style="{StaticResource PrimaryButton}" IsCancel="True" IsDefault="True" Click="OnClose" />
        </StackPanel>
    </Grid>
    <controls:CaptionButtons OnNavy="False" />
    </Grid>
</Window>

<Window x:Class="WinPortal.Ui.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinPortal.Ui.Controls"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="2" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- Barra fina azul-marinho: é também a barra da janela (arrastar, duplo clique, botões) -->
        <Border Background="{StaticResource NavyBrush}" Padding="12,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="LogoImage" Width="24" Height="24" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <DockPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AppNameText" DockPanel.Dock="Left" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextOnNavyBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="·" DockPanel.Dock="Left" Margin="8,0" FontSize="12" Foreground="{StaticResource TextOnNavyMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TaglineText" FontSize="12" Foreground="{StaticResource TextOnNavyMutedBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="SettingsButton" Style="{StaticResource NavyCompactButton}" Click="OnSettingsClick" Margin="0,0,6,0"
                            ToolTip="Configurações: tema e atualizações" AutomationProperties.Name="Configurações">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="LicenseButton" Style="{StaticResource NavyCompactButton}" Click="OnLicenseClick"
                            ToolTip="Ver ou alterar a ativação deste computador">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LicenseDot" Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{StaticResource TextOnNavyMutedBrush}" />
                            <TextBlock x:Name="LicenseText" Margin="7,0,0,0" Text="Verificando..." VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <controls:CaptionButtons Grid.Column="3" ButtonHeight="36" />
            </Grid>
        </Border>
        <Rectangle Grid.Row="1" Fill="{StaticResource AccentGradientBrush}" />

        <!-- Aviso de nova versão -->
        <Border x:Name="UpdateBanner" Grid.Row="2" Visibility="Collapsed" Background="{StaticResource BlueSoftBrush}"
                BorderBrush="{StaticResource BlueSelectionBrush}" BorderThickness="0,0,0,1" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"
                           Foreground="{StaticResource BlueBrush}" />
                <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="UpdateDetail" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    <ProgressBar x:Name="UpdateProgress" Margin="0,6,0,0" Visibility="Collapsed" MaxWidth="420" HorizontalAlignment="Left" Width="420" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="UpdateNotesButton" Style="{StaticResource LinkButton}" Content="O que mudou" Margin="0,0,16,0"
                            VerticalAlignment="Center" Click="OnUpdateNotes" />
                    <Button x:Name="UpdateLaterButton" Content="Depois" Margin="0,0,10,0" Click="OnUpdateLater" />
                    <Button x:Name="UpdateNowButton" Content="Atualizar agora" Style="{StaticResource PrimaryButton}" Click="OnUpdateNow" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo -->
        <ContentControl x:Name="ToolHost" Grid.Row="3" Focusable="False" />

        <Grid x:Name="LockedPanel" Grid.Row="3">
            <Border Style="{StaticResource Card}" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="32,30">
                <StackPanel>
                    <Image x:Name="LockedLogo" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="LockedTitle" Margin="0,16,0,0" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="LockedMessage" Margin="0,6,0,0" FontSize="13" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                    <StackPanel x:Name="LockedActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Button Content="Comprar licença" Margin="0,0,10,0" Click="OnBuyClick" />
                        <Button Content="Ativar licença" Style="{StaticResource PrimaryButton}" Click="OnLicenseClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Rodapé azul-marinho -->
        <Border Grid.Row="4" Background="{StaticResource NavyBrush}" Padding="24,0">
            <DockPanel VerticalAlignment="Center" LastChildFill="False">
                <TextBlock x:Name="FooterText" DockPanel.Dock="Left" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource TextOnNavyMutedBrush}" />
                <!-- Sino discreto: aparece quando a verificação encontrou uma versão nova -->
                <Button x:Name="UpdateBell" DockPanel.Dock="Left" Margin="8,0,0,0" Visibility="Collapsed"
                        Style="{StaticResource FooterIconButton}" Click="OnUpdateBell" AutomationProperties.Name="Nova versão disponível">
                    <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" />
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource NavyLinkButton}" Content="Minhas licenças" Click="OnAccountClick" />
                    <TextBlock Text="·" Margin="10,0" Foreground="{StaticResource TextOnNavyMutedBrush}" />
                    <Button Style="{StaticResource NavyLinkButton}" Content="nexotool.com.br" Click="OnSiteClick" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

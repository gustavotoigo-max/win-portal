<Window x:Class="WinPortal.Ui.Shell.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ativação" Width="500" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Background="{StaticResource NavyBrush}" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="LogoImage" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextOnNavyBrush}" />
                    <TextBlock x:Name="HeaderSubtitle" FontSize="12.5" Margin="0,2,0,0" Foreground="{StaticResource TextOnNavyMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
        <Rectangle Grid.Row="1" Fill="{StaticResource AccentGradientBrush}" />

        <!-- Formulário -->
        <StackPanel Grid.Row="2" Margin="24,20,24,8">
            <TextBlock Text="E-mail" Style="{StaticResource FieldLabelText}" Margin="0,0,0,6" />
            <TextBox x:Name="EmailBox" />

            <TextBlock Text="Chave de ativação" Style="{StaticResource FieldLabelText}" Margin="0,14,0,6" />
            <TextBox x:Name="KeyBox" Style="{StaticResource MonoTextBox}" CharacterCasing="Normal" />
            <TextBlock x:Name="KeyHint" Text="Formato WIN-XXXX-XXXX-XXXX-XXXX, exibido em Minhas licenças no site."
                       FontSize="11.5" Foreground="{StaticResource TextSubtleBrush}" Margin="0,6,0,0" />

            <Border x:Name="ActiveInfo" Margin="0,16,0,0" Padding="14,12" CornerRadius="10"
                    Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SITUAÇÃO" Style="{StaticResource SectionLabelText}" Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StateText" Margin="6,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource SuccessTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="VENCIMENTO" Style="{StaticResource SectionLabelText}" Margin="0,0,0,2" />
                        <TextBlock x:Name="ExpirationText" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText" Style="{StaticResource StatusText}" Margin="0,14,0,0" MinHeight="18" />
        </StackPanel>

        <!-- Rodapé -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BuyLink" Style="{StaticResource LinkButton}" Content="Comprar licença" Click="OnBuy" />
                    <TextBlock Text="·" Margin="8,0" Foreground="{StaticResource TextSubtleBrush}" />
                    <Button Style="{StaticResource LinkButton}" Content="Minhas licenças" Click="OnAccount" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ChangeButton" Content="Alterar ativação" Margin="0,0,10,0" Visibility="Collapsed" Click="OnChange" />
                    <Button x:Name="MainButton" Style="{StaticResource PrimaryButton}" Content="Ativar" IsDefault="True" Click="OnMain" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

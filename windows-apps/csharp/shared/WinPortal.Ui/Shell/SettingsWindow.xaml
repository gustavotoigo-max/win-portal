<Window x:Class="WinPortal.Ui.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações" Width="520" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Rectangle Fill="{StaticResource AccentGradientBrush}" />
        <StackPanel Grid.Row="1" Margin="24,20,24,22">
            <TextBlock Text="Configurações" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />

            <!-- Aparência -->
            <TextBlock Text="APARÊNCIA" Style="{StaticResource SectionLabelText}" Margin="0,18,0,8" />
            <TextBlock Text="Tema" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="AutoButton" Content="Automático" Click="OnTheme" Tag="Auto" />
                <Button x:Name="LightButton" Content="Claro" Margin="8,0,0,0" Click="OnTheme" Tag="Light" />
                <Button x:Name="DarkButton" Content="Escuro" Margin="8,0,0,0" Click="OnTheme" Tag="Dark" />
            </StackPanel>
            <TextBlock x:Name="ThemeHint" Margin="0,8,0,0" Style="{StaticResource StatusText}" />

            <!-- Atualizações -->
            <TextBlock Text="ATUALIZAÇÕES" Style="{StaticResource SectionLabelText}" Margin="0,22,0,8" />
            <TextBlock x:Name="VersionText" FontSize="13" Foreground="{StaticResource TextBrush}" />
            <CheckBox x:Name="AutoUpdateCheck" Margin="0,10,0,0" Content="Procurar atualizações automaticamente"
                      Checked="OnAutoUpdateChanged" Unchecked="OnAutoUpdateChanged" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="CheckButton" Content="Procurar agora" Click="OnCheckNow" />
                <Button x:Name="InstallButton" Content="Atualizar agora" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                        Visibility="Collapsed" Click="OnInstall" />
            </StackPanel>
            <TextBlock x:Name="UpdateStatus" Margin="0,8,0,0" Style="{StaticResource StatusText}" />
        </StackPanel>
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <Button Content="Fechar" HorizontalAlignment="Right" IsCancel="True" IsDefault="True" Click="OnClose" />
        </Border>
    </Grid>
</Window>

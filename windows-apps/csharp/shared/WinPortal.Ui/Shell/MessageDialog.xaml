<Window x:Class="WinPortal.Ui.Shell.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinPortal.Ui.Controls"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Rectangle x:Name="AccentBar" Fill="{StaticResource AccentGradientBrush}" />
        <Grid Grid.Row="1" Margin="24,22,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="IconCircle" Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top"
                    Background="{StaticResource BlueSoftBrush}">
                <TextBlock x:Name="IconGlyph" FontFamily="{StaticResource IconFont}" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource BlueBrush}" Text="&#xE946;" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                <TextBox x:Name="MessageText" Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                         TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Height="Auto" Padding="0" MaxHeight="360" VerticalScrollBarVisibility="Auto">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancelar" IsCancel="True" Margin="0,0,10,0"
                        Visibility="Collapsed" Click="OnCancel" />
                <Button x:Name="OkButton" Content="OK" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" />
            </StackPanel>
        </Border>
        <controls:CaptionButtons Grid.RowSpan="4" CloseOnly="True" OnNavy="False" />
    </Grid>
</Window>
